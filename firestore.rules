/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles, allowing users to read and write their own profile data.
 * Products and Challenges are publicly readable but not writable by clients.
 * Orders are owned by users, enabling them to create, read, and potentially update or delete their own orders.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data, with 'userId' matching the Firebase auth UID.
 * - /products/{productId}: Stores product details.
 * - /orders/{orderId}: Stores order information, with 'userId' linking to the user who placed the order.
 * - /challenges/{challengeId}: Stores available challenges.
 *
 * Key Security Decisions:
 * - Users can only manage their own profiles.
 * - Product and challenge data is publicly readable.
 * - Orders are user-specific.
 *
 * Denormalization for Authorization:
 * - The 'Order' entity requires a 'userId' field to link the order to the user. This allows for efficient owner-based security rules without additional queries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) User with uid "user123" can create their profile if request.auth.uid == "user123".
     * @allow (get) User with uid "user123" can read their profile.
     * @allow (update) User with uid "user123" can update their profile.
     * @allow (delete) User with uid "user123" can delete their profile.
     * @deny (create) User with uid "user456" cannot create profile for "user123".
     * @principle Enforces document ownership for writes, restricting access to a user's own data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if true;
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Allows anyone to read product information, but prevents modification.
     * @path /products/{productId}
     * @allow (get) Any user can read product details.
     * @allow (list) Any user can list products.
     * @deny (create) No one can create products via client.
     * @deny (update) No one can update products via client.
     * @deny (delete) No one can delete products via client.
     * @principle Provides public read access while restricting write access.
     */
    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows users to create, read, update, and delete their own orders.
     * @path /orders/{orderId}
     * @allow (create) User with uid "user123" can create an order with userId "user123".
     * @allow (get) User with uid "user123" can read order if order.userId == "user123".
     * @deny (create) User with uid "user456" cannot create an order for "user123".
     * @principle Enforces document ownership, allowing users to manage their own orders.
     */
    match /orders/{orderId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isExistingOwner(resource.data.userId);
      allow list: if false; // TODO: Only allow listing of own orders
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isExistingOwner(resource.data.userId) ;
      allow delete: if isExistingOwner(resource.data.userId);
    }

    /**
     * @description Allows anyone to read challenge information, but prevents modification.
     * @path /challenges/{challengeId}
     * @allow (get) Any user can read challenge details.
     * @allow (list) Any user can list challenges.
     * @deny (create) No one can create challenges via client.
     * @deny (update) No one can update challenges via client.
     * @deny (delete) No one can delete challenges via client.
     * @principle Provides public read access while restricting write access.
     */
    match /challenges/{challengeId} {
        allow get: if true;
        allow list: if true;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}